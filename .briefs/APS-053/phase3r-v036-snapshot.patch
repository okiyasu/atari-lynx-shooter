+/* APS-053 Phase 3R: movable objects (player/enemy/boss/power item/bullets/
+ * environment hazards) are drawn as Suzy SCBs instead of TGI runs. Suzy is
+ * fixed at 1x scale project-wide (APS-050), so SPRCTL1's HSIZE/VSIZE reload
+ * is never needed here: the hardware HSIZE/VSIZE registers already hold
+ * 0x0100 (1x) left over from the last SCB in the background chain
+ * (src/static_layer.c reset_scb always writes 0x0100 except for the one
+ * full-screen clear sprite, which static_layer_draw() always submits
+ * first in that same chain, before this one runs). SCB_RENONE/
+ * SCB_RENONE_PAL (_suzy.h, 11B/19B) are used instead of the 23B
+ * SCB_REHV_PAL the background layer uses, dropping the HSIZE/VSIZE/
+ * stretch/tilt fields this chain never reloads.
+ *
+ * The up to 43 concurrently-possible movable objects (player 1, enemy 8,
+ * boss 1, power item 1, player bullet 12, enemy bullet 16, environment
+ * hazard 4) fall into 7 kinds. Every instance of one kind is appended
+ * back-to-back within one draw_game() call -- draw order is never
+ * interleaved across kinds, see draw_game -- and every sprite belonging to
+ * one kind shares one real-color penpal table (confirmed by
+ * scripts/verify-phase-3r-sprite-bpp-gate.py together with the stage
+ * roster: each stage's enemy_formation draws from exactly one of the
+ * "enemy"/"mineral" sprite kinds, never both in the same frame). So only
+ * the first instance of a kind needs its own 19B penpal-carrying header
+ * (SCB_RENONE_PAL); every following instance of the same kind reuses it
+ * via REUSEPAL as an 11B SCB_RENONE. 7 headers x 19B + 36 followers x 11B
+ * = 529B, this pool's exact size -- see .briefs/APS-053/v036.md and
+ * docs/plan/2026-08-12-suzy-sprite-migration-v2.md section 5. Changing
+ * which objects count as the same "kind", or interleaving two kinds'
+ * append calls, invalidates this budget; re-derive it first if that ever
+ * changes. */
+#define MOVABLE_SCB_POOL_SIZE 529u
+static unsigned char movable_scb_pool[MOVABLE_SCB_POOL_SIZE];
+static unsigned char* movable_scb_cursor;
+static unsigned char* movable_scb_prev;
+static unsigned char* movable_scb_head;
+
+static void movable_scb_begin(void)
+{
+    movable_scb_cursor = movable_scb_pool;
+    movable_scb_prev = (unsigned char*)0;
+    movable_scb_head = (unsigned char*)0;
+}
+
+static void movable_append(unsigned char sprctl0, const unsigned char* penpal,
+    const unsigned char* data, int x, int y, unsigned char first_of_group)
+{
+    SCB_RENONE* scb;
+    SCB_RENONE_PAL* scb_pal;
+    unsigned char size;
+
+    size = first_of_group != 0u ? (unsigned char)sizeof(SCB_RENONE_PAL) :
+        (unsigned char)sizeof(SCB_RENONE);
+    if ((unsigned int)(movable_scb_cursor - movable_scb_pool) + size >
+        MOVABLE_SCB_POOL_SIZE) {
+        /* Never expected: the 43-slot budget above is exact. Drop the
+         * object rather than write past the pool if it is ever wrong. */
+        return;
+    }
+    scb = (SCB_RENONE*)movable_scb_cursor;
+    scb->sprctl0 = sprctl0;
+    scb->sprctl1 = (unsigned char)(PACKED | RENONE |
+        (first_of_group != 0u ? 0u : REUSEPAL));
+    scb->sprcoll = NO_COLLIDE;
+    scb->next = (char*)0;
+    scb->data = (unsigned char*)data;
+    scb->hpos = (signed int)x;
+    scb->vpos = (signed int)y;
+    if (first_of_group != 0u) {
+        scb_pal = (SCB_RENONE_PAL*)scb;
+        scb_pal->penpal[0] = penpal[0];
+        scb_pal->penpal[1] = penpal[1];
+        scb_pal->penpal[2] = penpal[2];
+        /* penpal[3..7] intentionally left unset: every movable sprite's
+         * packed data only ever emits local pixel values 1..
+         * SPRITE_MAX_COLORS (4, scripts/generate-stage-data.py), which map
+         * to penpal[0..2] only (see src/static_layer.c reset_scb comment
+         * for the nibble-packing rule), so Suzy never indexes past that
+         * for this data. */
+    }
+    if (movable_scb_prev != (unsigned char*)0) {
+        ((SCB_RENONE*)movable_scb_prev)->next = (char*)movable_scb_cursor;
+    } else {
+        movable_scb_head = movable_scb_cursor;
